PROJECT_NAME=BusinessOS AI
PROJECT_VERSION=1.0.0
DEBUG=True

API_V1_PREFIX=/api/v1

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=businessos_ai

SECRET_KEY=CHANGE_THIS_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Mail (SMTP) - e.g. Mailtrap sandbox; leave MAIL_USERNAME empty for local catchers
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@businessos.local
MAIL_FROM_NAME=BusinessOS AI
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_TIMEOUT_SECONDS=10

# Time zone and background jobs (Celery + Redis)
APP_TIMEZONE=Europe/Istanbul
CELERY_BROKER_URL=redis://localhost:6379/0
REMINDER_SCAN_INTERVAL_SECONDS=300
REMINDER_MIN_LEAD_MINUTES=60
REMINDER_MAX_ATTEMPTS=3
